{
  "name": "geo-radar",
  "version": "0.1.0",
  "private": false,
  "description": "Evidence-first GEO platform powered by Tencent Yuanbao SearchPro — traceable AI-search visibility, brand matrices, snapshots, comparisons and reports.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leterhong/GEO-Radar.git"
  },
  "homepage": "https://github.com/Leterhong/GEO-Radar#readme",
  "bugs": {
    "url": "https://github.com/Leterhong/GEO-Radar/issues"
  },
  "keywords": [
    "geo",
    "generative-engine-optimization",
    "ai-search",
    "yuanbao",
    "search-api",
    "brand-visibility",
    "nextjs",
    "prisma",
    "postgresql",
    "evidence"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:status": "prisma migrate status",
    "dev:db": "node scripts/dev-db.mjs",
    "docker:up": "node scripts/docker-up.mjs",
    "docker:down": "docker compose --env-file .env.docker down",
    "docker:logs": "docker compose --env-file .env.docker logs -f --tail=100",
    "scheduler": "node scripts/scheduler.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:evidence": "node scripts/smoke-evidence-chain.mjs",
    "verify:ui": "node scripts/ui-verify.mjs",
    "reset-password": "node scripts/reset-password.mjs",
    "token:create": "node scripts/create-token.mjs",
    "dsh:install": "node scripts/install-dsh-plugin.mjs",
    "dsh:native:install": "node scripts/install-dsh-native.mjs",
    "smoke:mcp": "node scripts/mcp-smoke.mjs",
    "key:import": "node scripts/import-env-key.mjs"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/client": "5.22.0",
