# ──────────────────────────────────────────────────────────────
# GEO Radar 环境变量示例 — 复制为 .env.local 后按需填写
# 不要把真实密钥提交到 Git
# ──────────────────────────────────────────────────────────────

# PostgreSQL 连接串（必填）
# 本地开发可用 docker compose 提供的数据库，或内嵌开发库：
#   npm run dev:db  （端口 15432，账号 georadar/georadar_dev_pw，库 georadar）
#   对应连接串：postgresql://georadar:georadar_dev_pw@localhost:15432/georadar
DATABASE_URL=

# 会话签名密钥（必填，至少 32 字节随机值）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# 敏感凭据加密密钥（必填，AES-256-GCM，32 字节）
# 用于加密存储元宝搜索 API Key；与被加密数据分开管理，不可提交 Git
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# ── 元宝搜索（服务 API Key 方式）────────────────────────────
# 全局开关：true 时才允许向元宝搜索发起真实请求；未配置/为 false 时真实搜索被阻止
YUANBAO_SEARCH_ENABLED=false
# 官方接口地址（默认值如下，一般无需填写；仅测试环境允许覆盖指向 Mock Server）
# YUANBAO_SEARCH_ENDPOINT=https://api.wsa.cloud.tencent.com/SearchPro

# 服务 API Key（可选）：填写后可用 `npm run key:import -- 邮箱` 把密钥
# 加密写入该账号的工作空间；运行期以数据库密文为准，不直接读取本变量。
# YUANBAO_SEARCH_API_KEY=

# ── 搜索执行 ────────────────────────────────────────────────
# 任务内并发数（1-5，默认 2）
SEARCH_CONCURRENCY=2
# 单次请求超时毫秒（默认 30000）
SEARCH_TIMEOUT_MS=30000
# 单次任务问题数硬上限（默认 100，最大 200）
# MAX_QUESTIONS_PER_TASK=100
# 单次任务最长执行时间（默认 1800000 = 30 分钟，最大 2 小时）
# TASK_TIMEOUT_MS=1800000

# ── 定时采集 ────────────────────────────────────────────────
# 外部 cron / scheduler 调用 /api/schedules/tick 的共享密钥（生产必填）
# 生成：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# CRON_SECRET=
# 独立 scheduler 进程访问的 Web 地址（scripts/scheduler.mjs 使用）
# APP_URL=http://127.0.0.1:3000
# tick 间隔毫秒（默认 60000，最小 30000）
# SCHEDULE_TICK_INTERVAL_MS=60000
# 同时运行的采集任务上限（默认 1，最大 5）
# SCHEDULE_MAX_CONCURRENT=1
# 单个定时排期单轮最多问题数（默认 50）
# SCHEDULE_MAX_QUESTIONS=50
# 每个工作空间最多启用的排期数量（默认 10）
# SCHEDULE_MAX_ACTIVE_PER_WORKSPACE=10
